# Copy to .env and fill in. Everything cloud-related is optional: without it the
# app uses the local model and the local intent engine.

# --- Security (REQUIRED for any shared deployment) ---------------------------
# Signs chatbot identity tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
ATTENDSMART_SECRET_KEY=
ATTENDSMART_DB_PATH=instance/attendsmart.db
ATTENDSMART_ALLOW_SIGNUP=true
# Optional fixed password for seeded demo accounts (otherwise random, written to
# instance/demo_credentials.txt)
ATTENDSMART_DEMO_PASSWORD=
# Optional: require X-API-Key on the API's /score route
ATTENDSMART_API_KEY=

# --- Azure ML (SDK v2 scripts in azure_ml/) -----------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE=
AZUREML_ENDPOINT_NAME=attendsmart-risk
# Filled in by: python azure_ml/deploy_endpoint.py --write-env
AZUREML_ENDPOINT_URL=
AZUREML_ENDPOINT_KEY=
AZUREML_DEPLOYMENT=

# --- Dialogflow ES --------------------------------------------------------------
DIALOGFLOW_PROJECT_ID=
DIALOGFLOW_LANGUAGE=en
# Service-account key with "Dialogflow API Client" (app) / "Dialogflow API Admin" (sync script)
GOOGLE_APPLICATION_CREDENTIALS=
# Basic-auth credentials Dialogflow uses when calling /dialogflow/webhook
DIALOGFLOW_WEBHOOK_USER=
DIALOGFLOW_WEBHOOK_PASSWORD=
