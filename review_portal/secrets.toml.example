# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud > App settings > Secrets.
admin_emails = ["mail.amitsahoo@gmail.com"]   # who can download the raw per-reviewer CSV

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # hosted: https://<your-app>.streamlit.app/oauth2callback
cookie_secret = "any-long-random-string"                 # python -c "import secrets;print(secrets.token_urlsafe(32))"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
